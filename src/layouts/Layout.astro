---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title = "BProducts - Price Arbitrage Finder",
  description = "Find the best deals and arbitrage opportunities across major e-commerce platforms. Real-time price comparison for maximum savings.",
  image = "/og-image.jpg",
  canonical,
  noindex = false
} = Astro.props;

const siteUrl = Astro.site || 'http://localhost:4321';
const canonicalURL = canonical || new URL(Astro.url.pathname, siteUrl);
const imageURL = new URL(image, siteUrl);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#2563eb" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="BProducts" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- Performance: preconnect fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" /></noscript>

    <!-- Critical CSS inline -->
    <style>
      body{font-family:'Inter',system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;line-height:1.6}.font-inter{font-family:'Inter',sans-serif}
    </style>

    <!-- Structured Data: WebApplication -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "BProducts",
      "url": siteUrl.toString(),
      "description": "Real-time price arbitrage finder for e-commerce products",
      "applicationCategory": "ShoppingApplication",
      "operatingSystem": "Web Browser",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    })} />
  </head>

  <body class="font-inter bg-white text-gray-900 antialiased">
    <!-- Header -->
    <header class="fixed top-0 left-0 right-0 bg-white border-b border-gray-200 z-50">
      <div class="max-w-7xl mx-auto px-4">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center">
            <div class="flex items-center space-x-2">
              <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center">
                <span class="text-white font-bold">B</span>
              </div>
              <span class="font-bold text-xl">BProducts</span>
            </div>
          </div>
          
          <nav class="hidden md:flex items-center space-x-8">
            <a href="#opportunities" class="text-gray-600 hover:text-gray-900 transition-colors">Opportunities</a>
            <a href="#products" class="text-gray-600 hover:text-gray-900 transition-colors">Products</a>
            <a href="/api/arbitrage-data" class="text-gray-600 hover:text-gray-900 transition-colors">API</a>
          </nav>
          
          <div class="flex items-center space-x-4">
            <button onclick="loadLatestData()" class="px-4 py-2 text-sm bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
              🔄 Refresh
            </button>
          </div>
        </div>
      </div>
    </header>

    <main id="main-content" class="pt-16">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-gray-900 text-white py-12">
      <div class="max-w-7xl mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <div class="col-span-1 md:col-span-2">
            <div class="flex items-center space-x-2 mb-4">
              <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center">
                <span class="text-white font-bold">B</span>
              </div>
              <span class="font-bold text-xl">BProducts</span>
            </div>
            <p class="text-gray-400 mb-4">
              Real-time price arbitrage finder helping you discover the best deals across major e-commerce platforms.
            </p>
            <div class="flex items-center space-x-4 text-sm text-gray-400">
              <span>🔄 Auto-refresh every 5 minutes</span>
              <span>📊 Live price tracking</span>
            </div>
          </div>
          
          <div>
            <h3 class="font-semibold mb-4">Platforms</h3>
            <ul class="space-y-2 text-gray-400 text-sm">
              <li>• Bol.com</li>
              <li>• Amazon NL</li>
              <li>• Coolblue</li>
            </ul>
          </div>
          
          <div>
            <h3 class="font-semibold mb-4">Data</h3>
            <ul class="space-y-2 text-gray-400 text-sm">
              <li>• Real-time scraping</li>
              <li>• Price comparison</li>
              <li>• Arbitrage analysis</li>
            </ul>
          </div>
        </div>
        
        <div class="border-t border-gray-800 mt-8 pt-8 flex flex-col md:flex-row items-center justify-between text-sm text-gray-400">
          <span>© {new Date().getFullYear()} BProducts. No-budget price arbitrage solution.</span>
          <div class="flex items-center space-x-4 mt-4 md:mt-0">
            <span>Last updated: <span id="footer-last-updated">Just now</span></span>
          </div>
        </div>
      </div>
    </footer>

    <script>
      // Update footer timestamp
      function updateFooterTimestamp() {
        document.getElementById('footer-last-updated').textContent = new Date().toLocaleTimeString();
      }
      
      // Update timestamp every minute
      setInterval(updateFooterTimestamp, 60000);
      
      // Smooth scroll for anchor links
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
          e.preventDefault();
          const target = document.querySelector(this.getAttribute('href'));
          if (target) {
            target.scrollIntoView({ behavior: 'smooth' });
          }
        });
      });
    </script>
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
    overflow-x: hidden;
  }

  body {
    font-family: 'Inter', sans-serif;
    background-color: #ffffff;
    color: #111827;
    overflow-x: hidden;
  }

  /* Better tap targets on mobile */
  a, button {
    -webkit-tap-highlight-color: transparent;
  }

  /* Ensure images don't overflow */
  img {
    max-width: 100%;
    height: auto;
  }

  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
  }

  ::-webkit-scrollbar-track {
    background: #f1f1f1;
  }

  ::-webkit-scrollbar-thumb {
    background: #888;
    border-radius: 4px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: #555;
  }
</style>
