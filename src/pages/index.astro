---
import Layout from '../layouts/Layout.astro';
---

<Layout title="BProducts - NL Prijs Arbitrage Platform" description="Vind de beste deals voor populaire producten in Nederlandse webshops. Vergelijk prijzen en bespaar geld met real-time arbitrage.">
  <!-- 3D Hero Section -->
  <section class="relative min-h-screen bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 overflow-hidden">
    <!-- Animated Background -->
    <div class="absolute inset-0">
      <div class="absolute inset-0 bg-gradient-to-r from-blue-600/20 to-purple-600/20 animate-pulse"></div>
      <div class="absolute top-20 left-10 w-72 h-72 bg-purple-500/10 rounded-full blur-3xl animate-blob"></div>
      <div class="absolute top-40 right-10 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl animate-blob animation-delay-2000"></div>
      <div class="absolute bottom-20 left-1/2 w-80 h-80 bg-indigo-500/10 rounded-full blur-3xl animate-blob animation-delay-4000"></div>
    </div>
    
    <!-- Content -->
    <div class="relative z-10 flex items-center justify-center min-h-screen px-4">
      <div class="text-center max-w-4xl mx-auto">
        <div class="mb-8">
          <h1 class="text-6xl md:text-8xl font-bold text-white mb-6 animate-fade-in">
            B<span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-400">Products</span>
          </h1>
          <p class="text-xl md:text-2xl text-gray-300 mb-8 animate-slide-up">
            Vind de <span class="text-blue-400 font-semibold">beste deals</span> voor populaire producten in Nederland
          </p>
        </div>
        
        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
          <div class="bg-white/10 backdrop-blur-md rounded-xl p-6 border border-white/20 animate-fade-in animation-delay-200">
            <div class="text-4xl font-bold text-white mb-2" id="total-products">5</div>
            <div class="text-gray-300">Producten Geanalyseerd</div>
          </div>
          <div class="bg-white/10 backdrop-blur-md rounded-xl p-6 border border-white/20 animate-fade-in animation-delay-400">
            <div class="text-4xl font-bold text-green-400 mb-2" id="total-savings">€560</div>
            <div class="text-gray-300">Potentiële Besparing</div>
          </div>
          <div class="bg-white/10 backdrop-blur-md rounded-xl p-6 border border-white/20 animate-fade-in animation-delay-600">
            <div class="text-4xl font-bold text-blue-400 mb-2" id="webshops">8</div>
            <div class="text-gray-300">Webshops Vergeleken</div>
          </div>
        </div>
        
        <!-- CTA Button -->
        <div class="animate-slide-up animation-delay-800">
          <button onclick="document.getElementById('products').scrollIntoView({behavior: 'smooth'})" 
                  class="bg-gradient-to-r from-blue-600 to-purple-600 text-white px-8 py-4 rounded-full text-lg font-semibold hover:from-blue-700 hover:to-purple-700 transform hover:scale-105 transition-all duration-300 shadow-2xl">
            🛍️ Ontdek Arbitrage Deals
          </button>
        </div>
      </div>
    </div>
    
    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-white/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m14 0v3a2 2 0 002 2H5a2 2 0 00-2-2V5a2 2 0 012-2h14a2 2 0 012 2z"></path>
      </svg>
    </div>
  </section>

  <!-- Products Grid Section -->
  <section id="products" class="py-20 bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">Populaire Producten</h2>
        <p class="text-xl text-gray-600">Real-time prijsvergelijking voor de beste deals</p>
      </div>
      
      <div id="products-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Products will be loaded here -->
      </div>
    </div>
  </section>

  <!-- Product Detail Modal -->
  <div id="product-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm hidden z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-4xl w-full max-h-[90vh] overflow-y-auto shadow-2xl">
      <div class="p-8">
        <div class="flex justify-between items-start mb-6">
          <h2 id="modal-product-name" class="text-3xl font-bold text-gray-900"></h2>
          <button onclick="closeProductModal()" class="text-gray-500 hover:text-gray-700 transition-colors">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        
        <div id="modal-content" class="space-y-8">
          <!-- Product details will be loaded here -->
        </div>
      </div>
    </div>
  </section>

  <style>
    @keyframes blob {
      0%, 100% { transform: translate(0px, 0px) scale(1); }
      33% { transform: translate(30px, -50px) scale(1.1); }
      66% { transform: translate(-20px, 20px) scale(0.9); }
    }
    
    @keyframes fade-in {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    @keyframes slide-up {
      from { opacity: 0; transform: translateY(40px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    .animate-blob {
      animation: blob 7s infinite;
    }
    
    .animation-delay-2000 {
      animation-delay: 2s;
    }
    
    .animation-delay-4000 {
      animation-delay: 4s;
    }
    
    .animation-delay-400 {
      animation-delay: 0.4s;
    }
    
    .animation-delay-600 {
      animation-delay: 0.6s;
    }
    
    .animation-delay-800 {
      animation-delay: 0.8s;
    }
    
    .animate-fade-in {
      animation: fade-in 0.8s ease-out forwards;
    }
    
    .animate-slide-up {
      animation: slide-up 0.8s ease-out forwards;
    }
    
    .bg-clip-text {
      -webkit-background-clip: text;
      background-clip: text;
    }
  </style>

  <script>
    // Product data
    const products = [
      {
        id: "iphone-15-pro",
        name: "Apple iPhone 15 Pro 128GB Natural Titanium",
        category: "electronics",
        description: "De nieuwste iPhone 15 Pro met A17 Pro chip, titanium behuizing en geavanceerde camera's.",
        image: "https://images.unsplash.com/photo-1592750475162-4a1a1c0b5b5?w=800&h=600&fit=crop",
        min_price: {
          platform: "Bol.com",
          price: 1099.00,
          url: "https://bol.com/nl/p/iphone-15-pro-128gb-natural-titanium/9300000001023177/",
          availability: "Op voorraad"
        },
        max_price: {
          platform: "MediaMarkt",
          price: 1249.00,
          url: "https://www.mediamarkt.nl/nl/product/_apple-iphone-15-pro-128-gb-natural-titanium-1402588.html",
          availability: "Op voorraad"
        },
        profit: 150.00,
        profit_percentage: 13.6
      },
      {
        id: "airpods-pro-2",
        name: "Apple AirPods Pro (2nd generation) met MagSafe Case",
        category: "electronics",
        description: "Actieve noise cancelling, ruimtelijke audio en MagSafe oplader.",
        image: "https://images.unsplash.com/photo-1602562938282-6e4e028b5b5?w=800&h=600&fit=crop",
        min_price: {
          platform: "Amazon NL",
          price: 249.00,
          url: "https://www.amazon.nl/apple-airpods-pro-2nd-generation/dp/B0DQGXPY6/",
          availability: "Op voorraad"
        },
        max_price: {
          platform: "Coolblue",
          price: 299.00,
          url: "https://www.coolblue.nl/nl/apple-airpods-pro-2e-generatie-magsafe-case/product/950878",
          availability: "Op voorraad"
        },
        profit: 50.00,
        profit_percentage: 20.1
      },
      {
        id: "samsung-s24-ultra",
        name: "Samsung Galaxy S24 Ultra 256GB",
        category: "electronics",
        description: "Samsung's vlaggenschip met S Pen, titanium frame en AI camera.",
        image: "https://images.unsplash.com/photo-1598327873645-7b4c3b5b5b5?w=800&h=600&fit=crop",
        min_price: {
          platform: "Bol.com",
          price: 1199.00,
          url: "https://bol.com/nl/p/samsung-galaxy-s24-ultra-256gb-titanium-black/9300000008600980/",
          availability: "Op voorraad"
        },
        max_price: {
          platform: "Expert",
          price: 1399.00,
          url: "https://www.expert.nl/samsung-galaxy-s24-ultra-256gb-titanium-black/624823/",
          availability: "Op voorraad"
        },
        profit: 200.00,
        profit_percentage: 16.7
      },
      {
        id: "playstation-5",
        name: "Sony PlayStation 5 Console",
        category: "gaming",
        description: "Next-gen gaming met 4K gaming, haptic feedback en snelle SSD.",
        image: "https://images.unsplash.com/photo-1606147567936-4a1c1c0b5b5?w=800&h=600&fit=crop",
        min_price: {
          platform: "Amazon NL",
          price: 449.00,
          url: "https://www.amazon.nl/playstation-5-console/dp/B08H95Y452/",
          availability: "Op voorraad"
        },
        max_price: {
          platform: "GameMania",
          price: 549.00,
          url: "https://www.gamemania.nl/playstation-5.html",
          availability: "Op voorraad"
        },
        profit: 100.00,
        profit_percentage: 22.3
      },
      {
        id: "nintendo-switch-oled",
        name: "Nintendo Switch OLED Model",
        category: "gaming",
        description: "Draagbare gaming met 7-inch OLED scherm en verbeterde audio.",
        image: "https://images.unsplash.com/photo-1578302990449-4e9b7b5b5b5?w=800&h=600&fit=crop",
        min_price: {
          platform: "Bol.com",
          price: 319.00,
          url: "https://bol.com/nl/p/nintendo-switch-oled-model-wit/9300000015999750/",
          availability: "Op voorraad"
        },
        max_price: {
          platform: "Coolblue",
          price: 379.00,
          url: "https://www.coolblue.nl/nl/nintendo-switch-oled-model-wit/product/950879",
          availability: "Op voorraad"
        },
        profit: 60.00,
        profit_percentage: 18.8
      }
    ];

    // Initialize page
    document.addEventListener('DOMContentLoaded', () => {
      displayProducts();
      updateStats();
    });

    function displayProducts() {
      const grid = document.getElementById('products-grid');
      
      grid.innerHTML = products.map((product, index) => `
        <div class="group bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden transform hover:-translate-y-2 animate-fade-in" 
             style="animation-delay: ${index * 0.1}s">
          <div class="relative">
            <img src="${product.image}" alt="${product.name}" 
                 class="w-full h-48 object-cover group-hover:scale-110 transition-transform duration-500">
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          </div>
          
          <div class="p-6">
            <div class="mb-4">
              <h3 class="text-xl font-bold text-gray-900 mb-2">${product.name}</h3>
              <p class="text-gray-600 text-sm">${product.description}</p>
            </div>
            
            <div class="grid grid-cols-2 gap-4 mb-4">
              <div class="bg-green-50 rounded-lg p-3">
                <div class="text-sm text-green-600 font-medium mb-1">💰 Goedkoopste</div>
                <div class="font-semibold text-gray-900">${product.min_price.platform}</div>
                <div class="text-2xl font-bold text-green-600">€${product.min_price.price.toFixed(2)}</div>
              </div>
              <div class="bg-red-50 rounded-lg p-3">
                <div class="text-sm text-red-600 font-medium mb-1">💸 Duurste</div>
                  <div class="font-semibold text-gray-900">${product.max_price.platform}</div>
                  <div class="text-2xl font-bold text-red-600">€${product.max_price.price.toFixed(2)}</div>
                </div>
              </div>
            
            <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-4">
              <div class="flex items-center justify-between">
                <div>
                  <div class="text-sm text-yellow-600 font-medium">💡 Besparing</div>
                  <div class="text-3xl font-bold text-yellow-600">€${product.profit.toFixed(2)}</div>
                </div>
                <div class="text-right">
                  <div class="text-sm text-gray-600">${product.profit_percentage.toFixed(1)}%</div>
                  <div class="text-xs text-gray-500">korting</div>
                </div>
              </div>
            </div>
            
            <div class="flex gap-3">
              <a href="${product.min_price.url}" target="_blank" 
                 class="flex-1 bg-green-600 text-white px-4 py-3 rounded-lg text-center font-medium hover:bg-green-700 transition-colors">
                🛒️ Koop Goedkoopste
              </a>
              <button onclick="viewProductDetails('${product.id}')" 
                      class="flex-1 bg-blue-600 text-white px-4 py-3 rounded-lg font-medium hover:bg-blue-700 transition-colors">
                📊 Bekijk Details
              </button>
            </div>
          </div>
        </div>
      `).join('');
    }

    function updateStats() {
      const totalSavings = products.reduce((sum, p) => sum + p.profit, 0);
      document.getElementById('total-savings').textContent = `€${totalSavings.toFixed(0)}`;
    }

    function viewProductDetails(productId) {
      const product = products.find(p => p.id === productId);
      if (!product) return;

      document.getElementById('modal-product-name').textContent = product.name;
      
      const modalContent = document.getElementById('modal-content');
      modalContent.innerHTML = `
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <div>
            <img src="${product.image}" alt="${product.name}" 
                 class="w-full rounded-xl shadow-lg">
          </div>
          
          <div class="space-y-6">
            <div>
              <h3 class="text-xl font-bold text-gray-900 mb-3">Product Beschrijving</h3>
              <p class="text-gray-600 leading-relaxed">${product.description}</p>
            </div>
            
            <div class="bg-gradient-to-r from-blue-50 to-green-50 rounded-xl p-6">
              <h4 class="text-lg font-bold text-gray-900 mb-4">Prijs Analyse</h4>
              <div class="grid grid-cols-3 gap-4">
                <div class="text-center">
                  <div class="text-sm text-green-600 font-medium mb-2">💰 Goedkoopste</div>
                  <div class="text-2xl font-bold text-green-700">€${product.min_price.price.toFixed(2)}</div>
                  <div class="text-sm text-gray-600">${product.min_price.platform}</div>
                </div>
                <div class="text-center">
                  <div class="text-sm text-blue-600 font-medium mb-2">📊 Gemiddelde</div>
                  <div class="text-2xl font-bold text-blue-700">€${((product.min_price.price + product.max_price.price) / 2).toFixed(2)}</div>
                  <div class="text-sm text-gray-600">Markt gemiddelde</div>
                </div>
                <div class="text-center">
                  <div class="text-sm text-red-600 font-medium mb-2">💸 Duurste</div>
                  <div class="text-2xl font-bold text-red-700">€${product.max_price.price.toFixed(2)}</div>
                  <div class="text-sm text-gray-600">${product.max_price.platform}</div>
                </div>
              </div>
            </div>
            
            <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-6">
              <h4 class="text-lg font-bold text-gray-900 mb-3">💡 Besparingskans</h4>
              <div class="text-center">
                <div class="text-4xl font-bold text-yellow-600 mb-2">€${product.profit.toFixed(2)}</div>
                <div class="text-lg text-gray-600">Bespaar ${product.profit_percentage.toFixed(1)}% door te kopen bij ${product.min_price.platform}</div>
              </div>
            </div>
            
            <div class="space-y-4">
              <h4 class="text-lg font-bold text-gray-900 mb-3">Beschikbare Winkels</h4>
              ${[product.min_price, product.max_price].map(shop => `
                <div class="border rounded-lg p-4 ${shop === product.min_price ? 'border-green-500 bg-green-50' : 'border-gray-300 bg-gray-50'}">
                  <div class="flex items-center justify-between">
                    <div>
                      <div class="font-semibold text-gray-900">${shop.platform}</div>
                      <div class="text-sm text-gray-600">${shop.availability}</div>
                    </div>
                    <div class="text-right">
                      <div class="text-2xl font-bold ${shop === product.min_price ? 'text-green-600' : 'text-gray-900'}">€${shop.price.toFixed(2)}</div>
                      <a href="${shop.url}" target="_blank" 
                         class="inline-block mt-2 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                        ${shop === product.min_price ? '🛒️ Koop Nu' : '👁️ Bekijk Winkel'}
                      </a>
                    </div>
                  </div>
                </div>
              `).join('')}
            </div>
          </div>
        </div>
      `;
      
      document.getElementById('product-modal').classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeProductModal() {
      document.getElementById('product-modal').classList.add('hidden');
      document.body.style.overflow = 'auto';
    }
  </script>
</Layout>
